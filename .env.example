# Copy to .env (git-ignored) and adjust. docker compose reads .env automatically.
# Every value has a safe local default; nothing here is required for a first run.

# PostgreSQL container credentials (local throwaway container only)
POSTGRES_USER=tradeflow
POSTGRES_PASSWORD=tradeflow

# Tokens are RS256. The Docker stack generates the key pair and the data-encryption keys
# itself (one-shot `keygen` container, named volumes); nothing to set here.
# Service client secrets (portfolio-service -> user-service). The local profile has public
# placeholders; set private values (>= 24 characters) anywhere else.
TRADEFLOW_SERVICE_SECRET_PORTFOLIO=
TRADEFLOW_SERVICE_SECRET_LIVE=

# Demo data (seeded users demo@tradeflow.dev / admin@tradeflow.dev)
TRADEFLOW_DEMO_ENABLED=true
TRADEFLOW_DEMO_PASSWORD=Demo@12345

# Simulated market tick interval in milliseconds
TRADEFLOW_MARKET_TICK_MS=30000

# AI assistant. 'none' = deterministic answers only (no external calls).
# 'anthropic' = use Claude; requires ANTHROPIC_API_KEY. Never commit a real key.
TRADEFLOW_AI_PROVIDER=none
ANTHROPIC_API_KEY=

# Live broker (phase 6: Angel One SmartAPI, READ-ONLY; no real orders can be placed).
# 'none' = no broker. 'angelone' needs the API key of your SmartAPI app (smartapi.angelone.in),
# whose redirect URL must be http://localhost:3000/live/broker/callback. TradeFlow never needs your
# Angel One password, PIN or TOTP. Copy this file to .env (git-ignored) and fill values in there,
# never in this file. Optional: the real local/public IPv4 and MAC address of the machine running
# TradeFlow (sent as SmartAPI's client headers). See docs/ANGELONE_SETUP.md.
TRADEFLOW_LIVE_BROKER=none
TRADEFLOW_ANGELONE_API_KEY=
TRADEFLOW_ANGELONE_CLIENT_LOCAL_IP=
TRADEFLOW_ANGELONE_CLIENT_PUBLIC_IP=
TRADEFLOW_ANGELONE_MAC_ADDRESS=
